// The landing page, served by Cloudflare as a Worker with static assets. One small script runs for
// the demo videos only, to answer Range requests (site/worker/ranges.js); everything else is assets.
// `npx wrangler deploy` builds the page itself (build.command) and uploads site/dist, whatever build
// command the dashboard has.
// site/dist carries _headers and _redirects (/install -> the release's install.sh).
{
  "name": "angelia",
  "compatibility_date": "2026-09-01",
  "build": { "command": "node site/build.mjs" },
  "main": "site/worker/ranges.js",
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/angelia-demo*"]
  },
  // Branch builds run `wrangler preview`, which needs this block (empty is enough for assets only).
  "previews": {}
}
