// The landing page, served by Cloudflare as a Worker with static assets and no script.
// `npx wrangler deploy` builds the page itself (build.command) and uploads site/dist, whatever build
// command the dashboard has.
// site/dist carries _headers and _redirects (/install -> the release's install.sh).
{
  "name": "angelia",
  "compatibility_date": "2026-09-01",
  "build": { "command": "node site/build.mjs" },
  "assets": { "directory": "./site/dist", "not_found_handling": "404-page" }
}
